# Nebula Configuration - Project Brahmanda (Vyom Node)
# Managed by Ansible - DO NOT EDIT MANUALLY
# Node: {{ inventory_hostname }}

# IMPORTANT: Certificates must include appropriate groups:
#   - Control plane: groups "vyom,vyom-control-plane"
#   - Workers: groups "vyom,vyom-worker"
# Generated with: nebula-cert sign -name "<node>" -ip "<ip>/16" -groups "vyom,<role>"
# See: vaastu/anvaya/nebula/Identity-Design-Patterns.md

pki:
  ca: {{ pki.ca }}
  cert: {{ pki.cert }}
  key: {{ pki.key }}

static_host_map:
  "10.100.0.1":
    - "{{ hostvars['kshitiz-lighthouse']['ansible_host'] }}:4242"

lighthouse:
  am_lighthouse: false
  serve_dns: false
  interval: 60
  hosts:
    - "10.100.0.1"

# Relay configuration - use Kshitiz as relay if direct P2P fails
# Critical for North-South traffic when NAT hole-punching doesn't work
relay:
  am_relay: false
  use_relays: true
  relays:
    - 10.100.0.1  # Kshitiz lighthouse acts as relay

# LAN optimization - prefer local network when available
# This ensures Vyom nodes communicate over Fast LAN instead of going through internet
local_range: "192.168.68.0/24"
preferred_ranges: ["192.168.68.0/24"]

listen:
  host: {{ listen.host }}
  port: {{ listen.port }}

punchy:
  punch: true
  respond: true

tun:
  disabled: false
  dev: {{ tun.dev }}
  drop_local_broadcast: false
  drop_multicast: false
  tx_queue: 500
  mtu: 1280

logging:
  level: info
  format: text

firewall:
  conntrack:
    tcp_timeout: 120h
    udp_timeout: 3m
    default_timeout: 10m
    max_connections: 100000
  
  outbound:
{% for rule in outbound %}
    - port: "{{ rule.port }}"
      proto: "{{ rule.proto }}"
{% if rule.host is defined %}
      host: "{{ rule.host }}"
{% endif %}
{% if rule.groups is defined %}
      groups:
{% for group in rule.groups %}
        - "{{ group }}"
{% endfor %}
{% endif %}
{% endfor %}
  
  inbound:
{% for rule in inbound %}
    - port: "{{ rule.port }}"
      proto: "{{ rule.proto }}"
{% if rule.host is defined %}
      host: "{{ rule.host }}"
{% endif %}
{% if rule.groups is defined %}
      groups:
{% for group in rule.groups %}
        - "{{ group }}"
{% endfor %}
{% endif %}
{% endfor %}
