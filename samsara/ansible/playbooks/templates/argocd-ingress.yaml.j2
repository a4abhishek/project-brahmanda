apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-server
  namespace: {{ argocd_namespace }}
  annotations:
    # ADR-008: Traffic arrives as plain HTTP from Caddy over the Nebula mesh.
    # Use the 'web' (port 80) entrypoint. No TLS at this layer.
    traefik.ingress.kubernetes.io/router.entrypoints: web
spec:
  rules:
  - host: argocd.brahmanda.{{ domain_name }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: argocd-server
            port:
              number: 80
